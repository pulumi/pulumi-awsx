{
  "name": "@pulumi/awsx-experimental",
  "version": "0.0.1",
  "private": true,
  "description": "Experimental Pulumi components for AWS.",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:plugin",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:plugin": "node scripts/check-plugin.mjs"
  },
  "dependencies": {
    "@pulumi/aws": "7.42.0",
    "@pulumi/pulumi": "^3.200.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-jsdoc": "^64.3.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.16.0"
}
