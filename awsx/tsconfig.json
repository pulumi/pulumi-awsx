{
    "compilerOptions": {
        "outDir": "bin",
        "target": "ES2022",
        "useDefineForClassFields": false,
        "lib": [
            "ES2022"
        ],
        // TypeScript 6 no longer loads visible @types packages automatically.
        "types": [
            "node",
            "jest"
        ],
        "module": "commonjs",
        // The provider is emitted as CommonJS and packaged into a stand-alone executable.
        "moduleResolution": "bundler",
        "paths": {
            "@pulumi/aws": ["./node_modules/@pulumi/aws"],
            "@pulumi/aws/*": ["./node_modules/@pulumi/aws/*"],
            "@pulumi/pulumi": ["./node_modules/@pulumi/pulumi"],
            "@pulumi/pulumi/*": ["./node_modules/@pulumi/pulumi/*"]
        },
        "sourceMap": true,
        "stripInternal": true,
        "experimentalDecorators": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true
    },
    "exclude": [
        "bin",
        "tests",
        "scripts"
    ]
}
