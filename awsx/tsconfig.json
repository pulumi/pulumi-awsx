{
    "compilerOptions": {
        "outDir": "bin",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        // TypeScript 6 no longer loads visible @types packages automatically.
        "types": [
            "node",
            "jest"
        ],
        "module": "commonjs",
        "moduleResolution": "node",
        // Keep legacy CommonJS resolution until dependencies support Node16 resolution.
        "ignoreDeprecations": "6.0",
        "sourceMap": true,
        "stripInternal": true,
        "experimentalDecorators": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true
    },
    "exclude": [
        "bin",
        "tests",
        "scripts"
    ]
}
